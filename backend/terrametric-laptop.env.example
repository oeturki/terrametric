# Copy once: copy terrametric-laptop.env.example .env  (IPs are placeholders.)
# Or maintain gitignored bench file: backend/terrametric-laptop.local.env and run start_terrametric_laptop.ps1
#
# HARDWARE_PI_KEY must equal DEVICE_KEY on the Pi (.env beside arduino_bridge)

HARDWARE_PI_BASE=http://REPLACE_WITH_PI_IP:8765
HARDWARE_PI_KEY=TerrametricSharedKey_ChangeMe

# JWT signing (change from default if you expose the API)
SECRET_KEY=ChangeMeJwtSecret

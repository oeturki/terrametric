# Template only — IPs and MAC change when DHCP/USB changes. Never commit secrets.
#
# Recommended: cp terrametric-pi.env.example .env && edit once ( .env / terrametric-pi.local.env are gitignored)
# Bench-only file pi/terrametric-pi.local.env is ignored by git (copy from this template with your real IPs).
# Run: ./start_terrametric_pi.sh (sources .env OR terrametric-pi.local.env)

# Must match HARDWARE_PI_KEY in backend/.env line-for-line (copy/paste the value only).
DEVICE_KEY=REPLACE_SAME_AS_LAPTOP_HARDWARE_PI_KEY

# Pi hardware agent — laptop uses HARDWARE_PI_BASE=http://10.4.247.246:8765
#
# FastAPI runs on bench laptop — bridge POSTs ingest here:
# Bench laptop LAN IPv4: 10.3.25.73 (sanity-check from Pi:
#   curl -s http://10.3.25.73:8000/health )
TM_BRIDGE_API=http://10.3.25.73:8000


# HC-05 MAC — bridge uses RFCOMM socket (optional; omit TM_BRIDGE_* to use /dev/rfcomm0 + pyserial)
TM_BRIDGE_BT_MAC=00:00:00:00:00:00

# Local cmd server so hardware_agent sends S### to the same BT link:
TM_BRIDGE_CMD_SERVER=1
TM_BRIDGE_CMD_PORT=18765

# Arduino-servo via bridge HTTP (hardware_agent ventilation)
TERRA_ARDUINO_CMD_URL=http://127.0.0.1:18765/servo

# Camera: auto = try Picamera2 (libcamera) then raspistill (legacy/MMAL — use when raspistill works but libcamera-hello does not)
# TERRA_CAPTURE_BACKEND=raspistill

# Optional: Arduino mode off and use Pi GPIO + pigpio instead — uncomment:
# TERRA_USE_ARDUINO_SERVO=0
